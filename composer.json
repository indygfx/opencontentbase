{
    "name": "indygfx/opencontentbase",
    "description": "ContentBase - modulare Content-Plattform (PHP 8.2 + SQLite, kein Framework)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "league/commonmark": "^2.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "files": [
            "src/Core/helpers.php"
        ],
        "psr-4": {
            "Core\\": "src/Core/",
            "Pages\\": "modules/Pages/src/",
            "Writing\\": "modules/Writing/src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}